# Server
HOST=127.0.0.1
PORT=16100
# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO

# Twilio
# The account's auth token, used to verify X-Twilio-Signature
TWILIO_AUTH_TOKEN=
# Key for the HMAC-SHA256 that replaces the sender's number: openssl rand -hex 32
# A new key gives every sender a new address.
SENDER_HASH_KEY=

# Forwarding: comma-separated URLs, at least one in total
# Each gets {"address", "dialing_code", "iso", "text", "tag"} as JSON,
# e.g. a RelaySMS Publisher's https://<host>/v1/publications
FORWARD_URLS_JSON=
# Each gets Twilio's form unchanged, sender's number included
FORWARD_URLS_RAW=
# Optional "tag" sent to every JSON URL, e.g. the Publisher's OFFLINE_PUBLISH_SHARED_SECRET
FORWARD_TAG=
# Seconds per request; keep it under Twilio's 15-second webhook timeout
FORWARD_TIMEOUT=10
